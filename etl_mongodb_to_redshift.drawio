        </mxCell>
        <mxCell id="etl-job2" parent="processing-layer" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FF9900;strokeColor=#232F3E;fontColor=#232F3E;fontSize=10;align=left;spacingLeft=10" value="Glue ETL Job 2: LOAD TO Athena&lt;br&gt;• Incremental loads (partition/date watermark)&lt;br&gt;• SCD Type 2 (optional) for key dimensions&lt;br&gt;• COPY from S3 Staging to Athena Serverless" vertex="1">
